# Configuracoes do Servidor
SERVER_PORT=8080

# Configuracoes do PostgreSQL
DB_URL=jdbc:postgresql://screening-postgres:5432/sgh_screening
DB_USER=postgres
DB_PASSWORD=postgres

POSTGRES_DB=sgh_screening
POSTGRES_USER=postgres
POSTGRES_PASSWORD=12345678

# Configuracoes do JPA/Hibernate
JPA_DDL=update
JPA_SHOW_SQL=true

# Configuracoes do Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
TOPIC_SCREENING_CREATED=triagem.criada
TOPIC_SCREENING_CLASSIFIED=triagem.classificada
TOPIC_SCREENING_CRITICAL=triagem.critica
